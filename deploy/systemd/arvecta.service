[Unit]
Description=ARVECTA Technologies Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/arvecta/current
EnvironmentFile=/etc/arvecta/arvecta.env
ExecStart=/usr/bin/dotnet /opt/arvecta/current/Arvecta.Web.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=arvecta-web
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/arvecta

[Install]
WantedBy=multi-user.target
